# ──────────────────────────────────────────────────────────────────────────────
# AP Intelligence — Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME=AP Intelligence
APP_ENV=development          # development | staging | production
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# Storage — paths are relative to backend/ directory
DATABASE_PATH=data/ap_intelligence.db
STORAGE_PATH=storage/

# Cloud Vision & AI Keys
# Set your Gemini API key below to enable Gemini Cloud Vision extraction.
# If omitted or invalid, the pipeline falls back gracefully to local RapidOCR / PyMuPDF.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# OPENAI_API_KEY=
